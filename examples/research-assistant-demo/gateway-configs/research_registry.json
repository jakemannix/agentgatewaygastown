{
  "schemaVersion": "2.0",
  "description": "Research Assistant virtual tools registry with normalized output transforms",

  "schemas": [
    {
      "name": "NormalizedSearchResult",
      "version": "1.0.0",
      "description": "Common schema for all search results",
      "schema": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "description": "Title of the result"},
          "url": {"type": "string", "description": "URL to the resource"},
          "snippet": {"type": "string", "description": "Brief description or excerpt"},
          "source": {"type": "string", "description": "Source backend (exa, arxiv, github, huggingface)"},
          "source_type": {"type": "string", "description": "Content type (web, paper, repo, model, dataset, space)"}
        },
        "required": ["title", "url", "source"]
      }
    },
    {
      "name": "NormalizedSearchResponse",
      "version": "1.0.0",
      "description": "Unified search response with normalized results",
      "schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {"$ref": "#/schemas/NormalizedSearchResult"}
          }
        }
      }
    },
    {
      "name": "Entity",
      "version": "1.0.0",
      "schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "entity_type": {"type": "string"},
          "description": {"type": "string"},
          "similarity": {"type": "number"}
        }
      }
    },
    {
      "name": "Category",
      "version": "1.0.0",
      "schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "parent_id": {"type": "string"},
          "description": {"type": "string"},
          "similarity": {"type": "number"}
        }
      }
    }
  ],

  "servers": [
    {
      "name": "search-service",
      "version": "1.0.0",
      "description": "External search APIs",
      "provides": [
        {"tool": "exa_search", "version": "1.0.0"},
        {"tool": "arxiv_search", "version": "1.0.0"},
        {"tool": "github_search", "version": "1.0.0"},
        {"tool": "huggingface_search", "version": "1.0.0"}
      ]
    },
    {
      "name": "fetch-service",
      "version": "1.0.0",
      "description": "URL content fetching and extraction",
      "provides": [
        {"tool": "url_fetch", "version": "1.0.0"},
        {"tool": "extract_urls", "version": "1.0.0"},
        {"tool": "batch_fetch", "version": "1.0.0"}
      ]
    },
    {
      "name": "entity-service",
      "version": "1.0.0",
      "description": "Knowledge graph with semantic search",
      "provides": [
        {"tool": "entity_search", "version": "1.0.0"},
        {"tool": "get_entity", "version": "1.0.0"},
        {"tool": "create_entity", "version": "1.0.0"},
        {"tool": "update_entity", "version": "1.0.0"},
        {"tool": "delete_entity", "version": "1.0.0"},
        {"tool": "search_relations", "version": "1.0.0"},
        {"tool": "create_relation", "version": "1.0.0"},
        {"tool": "delete_relation", "version": "1.0.0"}
      ]
    },
    {
      "name": "category-service",
      "version": "1.0.0",
      "description": "Hierarchical category taxonomy",
      "provides": [
        {"tool": "search_categories", "version": "1.0.0"},
        {"tool": "get_category", "version": "1.0.0"},
        {"tool": "create_category", "version": "1.0.0"},
        {"tool": "update_category", "version": "1.0.0"},
        {"tool": "delete_category", "version": "1.0.0"},
        {"tool": "get_category_tree", "version": "1.0.0"},
        {"tool": "list_root_categories", "version": "1.0.0"}
      ]
    },
    {
      "name": "tag-service",
      "version": "1.0.0",
      "description": "Content tagging",
      "provides": [
        {"tool": "register_content", "version": "1.0.0"},
        {"tool": "get_content", "version": "1.0.0"},
        {"tool": "tag_content", "version": "1.0.0"},
        {"tool": "untag_content", "version": "1.0.0"},
        {"tool": "search_tagged_content", "version": "1.0.0"},
        {"tool": "search_content", "version": "1.0.0"},
        {"tool": "bulk_tag", "version": "1.0.0"}
      ]
    }
  ],

  "tools": [
    {
      "name": "normalized_exa",
      "version": "1.0.0",
      "description": "Exa web search with normalized output schema (title, url, snippet, source)",
      "source": {
        "server": "search-service",
        "tool": "exa_search"
      },
      "outputTransform": {
        "mappings": {
          "results": {
            "arrayMap": {
              "over": "$.results",
              "each": {
                "title": {"path": "$.title"},
                "url": {"path": "$.url"},
                "snippet": {"coalesce": {"paths": ["$.text", "$.highlight"]}},
                "source": {"literal": {"stringValue": "exa"}},
                "source_type": {"literal": {"stringValue": "web"}}
              }
            }
          }
        }
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "normalized_arxiv",
      "version": "1.0.0",
      "description": "arXiv paper search with normalized output schema",
      "source": {
        "server": "search-service",
        "tool": "arxiv_search"
      },
      "outputTransform": {
        "mappings": {
          "results": {
            "arrayMap": {
              "over": "$.papers",
              "each": {
                "title": {"path": "$.title"},
                "url": {"coalesce": {"paths": ["$.pdf_url", "$.abs_url"]}},
                "snippet": {"path": "$.abstract"},
                "source": {"literal": {"stringValue": "arxiv"}},
                "source_type": {"literal": {"stringValue": "paper"}}
              }
            }
          }
        }
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "normalized_github",
      "version": "1.0.0",
      "description": "GitHub repository search with normalized output schema",
      "source": {
        "server": "search-service",
        "tool": "github_search"
      },
      "outputTransform": {
        "mappings": {
          "results": {
            "arrayMap": {
              "over": "$.repos",
              "each": {
                "title": {"path": "$.full_name"},
                "url": {"path": "$.html_url"},
                "snippet": {"path": "$.description"},
                "source": {"literal": {"stringValue": "github"}},
                "source_type": {"literal": {"stringValue": "repo"}}
              }
            }
          }
        }
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "normalized_huggingface",
      "version": "1.0.0",
      "description": "HuggingFace model search with normalized output schema",
      "source": {
        "server": "search-service",
        "tool": "huggingface_search"
      },
      "outputTransform": {
        "mappings": {
          "results": {
            "arrayMap": {
              "over": "$.models",
              "each": {
                "title": {"path": "$.id"},
                "url": {"path": "$.url"},
                "snippet": {"coalesce": {"paths": ["$.description", "$.pipeline_tag"]}},
                "source": {"literal": {"stringValue": "huggingface"}},
                "source_type": {"literal": {"stringValue": "model"}}
              }
            }
          }
        }
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "multi_source_search",
      "version": "1.0.0",
      "description": "Search across Exa (web), arXiv (papers), GitHub (repos), and HuggingFace (models) in parallel. Returns unified results object.",
      "spec": {
        "scatterGather": {
          "targets": [
            {"tool": "normalized_exa"},
            {"tool": "normalized_arxiv"},
            {"tool": "normalized_github"},
            {"tool": "normalized_huggingface"}
          ],
          "aggregation": {
            "ops": [
              {"extract": {"path": "$.results"}},
              {"flatten": true},
              {"dedupe": {"field": "$.url"}},
              {"wrap": {"field": "results"}}
            ]
          },
          "timeoutMs": 30000,
          "failFast": false
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search query"},
          "num_results": {"type": "integer", "description": "Max results per source", "default": 10}
        },
        "required": ["query"]
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "academic_search",
      "version": "1.0.0",
      "description": "Search academic sources: arXiv papers and HuggingFace models. Returns unified results object.",
      "spec": {
        "scatterGather": {
          "targets": [
            {"tool": "normalized_arxiv"},
            {"tool": "normalized_huggingface"}
          ],
          "aggregation": {
            "ops": [
              {"extract": {"path": "$.results"}},
              {"flatten": true},
              {"dedupe": {"field": "$.url"}},
              {"wrap": {"field": "results"}}
            ]
          },
          "timeoutMs": 30000,
          "failFast": false
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search query"},
          "num_results": {"type": "integer", "description": "Max results per source", "default": 10}
        },
        "required": ["query"]
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "code_search",
      "version": "1.0.0",
      "description": "Search for code implementations: GitHub repos and HuggingFace models. Returns unified results object.",
      "spec": {
        "scatterGather": {
          "targets": [
            {"tool": "normalized_github"},
            {"tool": "normalized_huggingface"}
          ],
          "aggregation": {
            "ops": [
              {"extract": {"path": "$.results"}},
              {"flatten": true},
              {"dedupe": {"field": "$.url"}},
              {"wrap": {"field": "results"}}
            ]
          },
          "timeoutMs": 30000,
          "failFast": false
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search query"},
          "num_results": {"type": "integer", "description": "Max results per source", "default": 10}
        },
        "required": ["query"]
      },
      "outputSchema": {"$ref": "#/schemas/NormalizedSearchResponse"}
    },

    {
      "name": "fetch_and_extract",
      "version": "1.0.0",
      "description": "Fetch a URL and extract all links from the content.",
      "spec": {
        "pipeline": {
          "steps": [
            {
              "id": "fetch",
              "operation": { "tool": { "name": "url_fetch", "server": "fetch-service" } },
              "input": {"input": {"path": "$"}}
            },
            {
              "id": "extract",
              "operation": { "tool": { "name": "extract_urls", "server": "fetch-service" } },
              "input": {
                "construct": {
                  "fields": {
                    "text": {"step": {"stepId": "fetch", "path": "$.content"}}
                  }
                }
              }
            }
          ]
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "description": "URL to fetch"}
        },
        "required": ["url"]
      }
    },

    {
      "name": "explore_entity_network",
      "version": "1.0.0",
      "description": "Explore an entity's network: get the entity details plus all its relations.",
      "spec": {
        "scatterGather": {
          "targets": [
            {"tool": "get_entity", "server": "entity-service"},
            {"tool": "search_relations", "server": "entity-service"}
          ],
          "aggregation": {
            "ops": [
              {"merge": true}
            ]
          },
          "timeoutMs": 10000,
          "failFast": false
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string", "description": "ID of entity to explore"}
        },
        "required": ["entity_id"]
      }
    },

    {
      "name": "get_knowledge_for_topic",
      "version": "1.0.0",
      "description": "Get all stored knowledge about a topic: related entities, categories, and tagged content.",
      "spec": {
        "scatterGather": {
          "targets": [
            {"tool": "entity_search", "server": "entity-service"},
            {"tool": "search_categories", "server": "category-service"},
            {"tool": "search_content", "server": "tag-service"}
          ],
          "aggregation": {
            "ops": [
              {"merge": true}
            ]
          },
          "timeoutMs": 15000,
          "failFast": false
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Topic to search for"}
        },
        "required": ["query"]
      }
    },

    {
      "name": "store_research_finding",
      "version": "1.0.0",
      "description": "Store a research finding: create an entity in the knowledge graph.",
      "source": {
        "server": "entity-service",
        "tool": "create_entity"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the finding/concept"},
          "entity_type": {"type": "string", "description": "Type (e.g., paper, concept, tool, person)"},
          "description": {"type": "string", "description": "Detailed description"}
        },
        "required": ["name", "entity_type", "description"]
      }
    },

    {
      "name": "link_entities",
      "version": "1.0.0",
      "description": "Create a relationship between two entities in the knowledge graph.",
      "source": {
        "server": "entity-service",
        "tool": "create_relation"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_entity_id": {"type": "string", "description": "Source entity ID"},
          "to_entity_id": {"type": "string", "description": "Target entity ID"},
          "predicate": {"type": "string", "description": "Relationship type (e.g., extends, cites, implements, related_to)"}
        },
        "required": ["from_entity_id", "to_entity_id", "predicate"]
      }
    },

    {
      "name": "find_or_create_category",
      "version": "1.0.0",
      "description": "Find categories matching a query, or create a new one if no good match exists.",
      "source": {
        "server": "category-service",
        "tool": "search_categories"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Category name or description to search for"},
          "limit": {"type": "integer", "description": "Max results", "default": 5}
        },
        "required": ["query"]
      }
    },

    {
      "name": "browse_taxonomy",
      "version": "1.0.0",
      "description": "Browse the category hierarchy starting from root categories.",
      "source": {
        "server": "category-service",
        "tool": "list_root_categories"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "description": "Max results", "default": 20}
        }
      }
    },

    {
      "name": "research_and_fetch",
      "version": "1.0.0",
      "description": "Complete research tool: searches multiple sources, checks knowledge graph context, and fetches content from top results. Returns entities, categories, search results, and page content in one call.",
      "spec": {
        "pipeline": {
          "steps": [
            {
              "id": "context",
              "operation": {
                "pattern": {
                  "scatterGather": {
                    "targets": [
                      {"tool": "entity_search", "server": "entity-service"},
                      {"tool": "search_categories", "server": "category-service"},
                      {"tool": "multi_source_search"}
                    ],
                    "aggregation": {
                      "ops": [{"merge": true}]
                    },
                    "timeoutMs": 30000,
                    "failFast": false
                  }
                }
              },
              "input": {"input": {"path": "$"}}
            },
            {
              "id": "fetch",
              "operation": {"tool": {"name": "batch_fetch", "server": "fetch-service"}},
              "input": {
                "construct": {
                  "fields": {
                    "urls": {"step": {"stepId": "context", "path": "$.results[*].url"}},
                    "max_length_per_url": {"constant": 3000}
                  }
                }
              }
            },
            {
              "id": "output",
              "operation": {
                "pattern": {
                  "schemaMap": {
                    "mappings": {
                      "relevant_entities": {"path": "$.context.entities"},
                      "relevant_categories": {"path": "$.context.categories"},
                      "search_results": {"path": "$.context.results"},
                      "fetched_content": {"path": "$.fetch.results"}
                    }
                  }
                }
              },
              "input": {
                "construct": {
                  "fields": {
                    "context": {"step": {"stepId": "context", "path": "$"}},
                    "fetch": {"step": {"stepId": "fetch", "path": "$"}}
                  }
                }
              }
            }
          ]
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Research topic to search for"},
          "num_results": {"type": "integer", "description": "Max results per search source", "default": 5},
          "limit": {"type": "integer", "description": "Max categories/entities to return", "default": 10}
        },
        "required": ["query"]
      }
    }
  ]
}
